<div class="container pb-5">
  <div class="row align-items-center mb-5">
    <div class="col-md-8">
      <h1 class="display-4 mb-0">Exciting Opportunities</h1>
    </div>
    <div class="col-md-4 text-md-end">
      <% if recruiter_signed_in? %>
        <%= link_to 'Post New Role', new_job_path, class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <% if @jobs.any? %>
        <div class="border-top border-dark border-2">
          <% @jobs.each do |job| %>
            <div class="job-row py-4 px-3">
              <div class="row align-items-center">
                <div class="col-md-8">
                  <h4 class="mb-1">
                    <%= link_to job.title, job_path(job), class: 'text-decoration-none text-dark' %>
                  </h4>
                  <p class="text-muted mb-2 small text-uppercase letter-spacing-1">
                    <%= job.recruiter.company_name rescue "Confidential Client" %> &nbsp;|&nbsp; 
                    <i class="fas fa-map-marker-alt"></i> <%= job.job_location %>
                  </p>
                  <p class="mb-0 text-secondary" style="font-size: 0.95rem;">
                    <%= truncate(job.description, length: 140) %>
                  </p>
                </div>
                
                <div class="col-md-4 d-flex flex-column align-items-md-end mt-3 mt-md-0">
                  <p class="fw-bold mb-3">$<%= job.salary %></p>
                  
                  <% if recruiter_signed_in? && job.recruiter == current_recruiter %>
                    <div class="btn-group">
                      <%= link_to 'Edit', edit_job_path(job), class: 'btn btn-sm btn-outline-secondary' %>
                      <%= link_to 'Withdraw', job_path(job), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-sm btn-outline-danger' %>
                    </div>
                  <% else %>
                    <%= link_to 'View Details', job_path(job), class: 'btn btn-outline-primary btn-sm' %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="py-5 text-center text-muted">
          <p class="fs-5">There are no active job postings at this time.</p>
          <% if recruiter_signed_in? %>
            <%= link_to 'Create a new job posting', new_job_path, class: 'text-decoration-none' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>