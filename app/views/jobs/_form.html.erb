<%= form_with(model: job, local: true) do |form| %>
  <% if job.errors.any? %>
    <div class="alert alert-danger rounded-0 border-0 border-start border-danger border-4">
      <h5 class="alert-heading" style="font-family: 'Playfair Display', serif;"><%= pluralize(job.errors.count, "error") %> prevented this job from being saved:</h5>
      <ul class="mb-0">
        <% job.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :title, "Position Title", class: "form-label fw-bold small text-uppercase text-secondary" %>
    <%= form.text_field :title, class: 'form-control form-control-lg rounded-0 border-secondary', placeholder: 'e.g. Director of Engineering' %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-4">
      <%= form.label :job_location, "Location", class: "form-label fw-bold small text-uppercase text-secondary" %>
      <%= form.text_field :job_location, class: 'form-control form-control-lg rounded-0 border-secondary', placeholder: 'e.g. New York, NY or Remote' %>
    </div>
    <div class="col-md-6 mb-4">
      <%= form.label :salary, "Compensation", class: "form-label fw-bold small text-uppercase text-secondary" %>
      <%= form.text_field :salary, class: 'form-control form-control-lg rounded-0 border-secondary', placeholder: 'e.g. $150,000 - $180,000' %>
    </div>
  </div>

  <div class="mb-4">
    <%= form.label :description, "Role Description", class: "form-label fw-bold small text-uppercase text-secondary" %>
    <%= form.text_area :description, rows: 6, class: 'form-control rounded-0 border-secondary', placeholder: 'Outline the scope, responsibilities, and key objectives...' %>
  </div>

  <div class="mb-5">
    <%= form.label :experience, "Required Experience", class: "form-label fw-bold small text-uppercase text-secondary" %>
    <%= form.text_area :experience, rows: 4, class: 'form-control rounded-0 border-secondary', placeholder: 'Detail the prerequisites and professional background required...' %>
  </div>

  <div class="d-flex gap-3">
    <%= form.submit "Publish Job", class: 'btn btn-primary btn-lg rounded-0 text-uppercase' %>
    <% if job.persisted? %>
      <%= link_to 'Cancel', job_path(job), class: 'btn btn-outline-secondary btn-lg rounded-0 text-uppercase' %>
    <% else %>
      <%= link_to 'Cancel', jobs_path, class: 'btn btn-outline-secondary btn-lg rounded-0 text-uppercase' %>
    <% end %>
  </div>
<% end %>