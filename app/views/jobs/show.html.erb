<div class="container my-5">
  <div class="mb-4">
    <%= link_to '← Back to Active Searches', jobs_path, class: 'text-decoration-none text-uppercase small fw-bold text-secondary' %>
  </div>

  <div class="row">
    <div class="col-lg-8 pe-lg-5">
      <!-- Header Section -->
      <div class="border-bottom pb-4 mb-4">
        <h1 class="display-4 fw-bold mb-3" style="font-family: 'Playfair Display', serif; color: #0F172A;"><%= @job.title %></h1>
        <div class="d-flex flex-wrap align-items-center text-muted small text-uppercase letter-spacing-1 fw-bold gap-3">
          <span class="text-primary"><i class="fas fa-building me-2"></i><%= @job.recruiter.company_name rescue "Confidential Client" %></span>
          <span class="d-none d-md-inline">|</span>
          <span><i class="fas fa-map-marker-alt me-2"></i><%= @job.job_location %></span>
          <% if @job.salary.present? %>
            <span class="d-none d-md-inline">|</span>
            <span><i class="fas fa-money-bill-wave me-2"></i><%= @job.salary %></span>
          <% end %>
        </div>
      </div>

      <!-- Content Section -->
      <div class="mb-5">
        <h5 class="text-uppercase text-secondary small fw-bold mb-3">Role Overview</h5>
        <div class="fs-5 text-dark" style="line-height: 1.8;">
          <%= simple_format(@job.description) %>
        </div>
      </div>

      <% if @job.experience.present? %>
        <div class="mb-5">
          <h5 class="text-uppercase text-secondary small fw-bold mb-3">Candidate Requirements</h5>
          <div class="text-dark" style="line-height: 1.8;">
            <%= simple_format(@job.experience) %>
          </div>
        </div>
      <% end %>
      
      <div class="text-muted small border-top pt-3">
        Listed <%= time_ago_in_words(@job.created_at) %> ago
      </div>
    </div>

    <!-- Sidebar Actions -->
    <div class="col-lg-4 mt-5 mt-lg-0">
      <div class="p-4 bg-light border border-secondary">
        <h5 class="text-uppercase text-secondary small fw-bold mb-4 border-bottom pb-2">Status & Actions</h5>
        
        <% if job_seeker_signed_in? %>
          <% application = current_job_seeker.job_applications.find_by(job_id: @job.id) %>
          <% if application %>
            <div class="alert alert-success rounded-0 border-0 border-start border-success border-4 d-flex align-items-center mb-0">
              <i class="fas fa-check-circle me-3 fs-4"></i> 
              <div>
                <strong>Applied!</strong><br>
                <span class="small">On <%= application.created_at.strftime("%B %d, %Y") %></span>
              </div>
            </div>
          <% else %>
            <%= form_with url: apply_job_path(@job), method: :patch, local: true, class: 'mb-0' do |f| %>
              <%= f.submit 'Apply', class: 'btn btn-primary btn-lg rounded-0 text-uppercase w-100' %>
            <% end %>
          <% end %>

        <% elsif recruiter_signed_in? && @job.recruiter == current_recruiter %>
          <div class="d-flex flex-column gap-2 mb-4">
            <%= link_to 'Revise Posting', edit_job_path(@job), class: 'btn btn-outline-secondary rounded-0 text-uppercase w-100' %>
            <%= link_to 'Withdraw Posting', job_path(@job), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to withdraw this position?' }, class: 'btn btn-outline-danger rounded-0 text-uppercase w-100' %>
          </div>
          
          <div class="mt-4 pt-4 border-top">
            <h5 class="text-uppercase text-secondary small fw-bold mb-3">Applicant Pool (<%= @job.job_applications.count %>)</h5>
            <% if @job.job_applications.any? %>
              <ul class="list-group list-group-flush rounded-0">
                <% @job.job_applications.each do |application| %>
                  <li class="list-group-item bg-transparent px-0 border-secondary">
                    <div class="fw-bold text-dark"><%= application.job_seeker.name || application.job_seeker.email %></div>
                    <small class="text-muted">Applied <%= time_ago_in_words(application.created_at) %> ago</small>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-muted small fst-italic">No candidates have applied yet.</p>
            <% end %>
          </div>

        <% elsif !job_seeker_signed_in? && !recruiter_signed_in? %>
          <div class="p-3 bg-white border">
            <p class="small mb-3 text-muted">Please authenticate to apply for this position.</p>
            <div class="d-flex flex-column gap-2">
              <%= link_to 'Sign In', new_job_seeker_session_path, class: 'btn btn-outline-primary rounded-0 text-uppercase w-100' %>
              <%= link_to 'Register', new_job_seeker_registration_path, class: 'btn btn-primary rounded-0 text-uppercase w-100' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>