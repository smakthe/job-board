<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="text-center mb-5">
      <h2 class="display-6 fw-bold" style="font-family: 'Playfair Display', serif; color: #0F172A;">
        <%= resource.class.name == "JobSeeker" ? "Candidate Registration" : "Client Registration" %>
      </h2>
      <p class="text-muted">Join our exclusive network today.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <% if resource.class.name == "JobSeeker" %>
        <div class="mb-4">
          <%= f.label :name, "Full Name", class: "form-label fw-bold small text-uppercase text-secondary" %>
          <%= f.text_field :name, autofocus: true, class: "form-control form-control-lg rounded-0 border-secondary" %>
        </div>
      <% elsif resource.class.name == "Recruiter" %>
        <div class="mb-4">
          <%= f.label :company_name, "Company Name", class: "form-label fw-bold small text-uppercase text-secondary" %>
          <%= f.text_field :company_name, autofocus: true, class: "form-control form-control-lg rounded-0 border-secondary" %>
        </div>
        
        <div class="mb-4">
          <%= f.label :contact_number, "Contact Number", class: "form-label fw-bold small text-uppercase text-secondary" %>
          <%= f.telephone_field :contact_number, class: "form-control form-control-lg rounded-0 border-secondary" %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :email, "Email Address", class: "form-label fw-bold small text-uppercase text-secondary" %>
        <%= f.email_field :email, autocomplete: "email", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "form-label fw-bold small text-uppercase text-secondary" %>
        <% if @minimum_password_length %>
          <span class="text-muted small">(<%= @minimum_password_length %> characters minimum)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-bold small text-uppercase text-secondary" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="d-grid mb-4">
        <%= f.submit "Register", class: "btn btn-primary btn-lg rounded-0 text-uppercase" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>