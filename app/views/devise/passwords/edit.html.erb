<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-4">
    <div class="text-center mb-5">
      <h2 class="display-6 fw-bold" style="font-family: 'Playfair Display', serif; color: #0F172A;">Change Password</h2>
      <p class="text-muted">Create a new, secure password.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-4">
        <%= f.label :password, "New password", class: "form-label fw-bold small text-uppercase text-secondary" %>
        <% if @minimum_password_length %>
          <span class="text-muted small">(<%= @minimum_password_length %> characters minimum)</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label fw-bold small text-uppercase text-secondary" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="d-grid mb-4">
        <%= f.submit "Change Password", class: "btn btn-primary btn-lg rounded-0 text-uppercase" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>