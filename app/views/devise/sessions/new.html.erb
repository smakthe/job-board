<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-4">
    <div class="text-center mb-5">
      <h2 class="display-6 fw-bold" style="font-family: 'Playfair Display', serif; color: #0F172A;">Sign In</h2>
      <p class="text-muted">Access your account to continue.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, class: "form-label fw-bold small text-uppercase text-secondary" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "form-label fw-bold small text-uppercase text-secondary" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg rounded-0 border-secondary" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-4 form-check">
          <%= f.check_box :remember_me, class: "form-check-input rounded-0 border-secondary" %>
          <%= f.label :remember_me, class: "form-check-label text-muted" %>
        </div>
      <% end %>

      <div class="d-grid mb-4">
        <%= f.submit "Sign In", class: "btn btn-primary btn-lg rounded-0 text-uppercase" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>